# ─────────────────────────────────────────────────────────────
#  OPTIONAL.
#  You do NOT need this file — JARVIS asks for your key on first
#  run and stores it in data/settings.json (git-ignored).
#  Use this only if you prefer environment variables.
#  Copy to ".env" and fill in.
# ─────────────────────────────────────────────────────────────

# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave blank to auto-detect the best Flash model on your key.
GEMINI_MODEL=

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
